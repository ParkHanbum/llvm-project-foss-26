define i32 @different_offsets(i1 %cond, i32 %depth, ptr %out) optsize {
; CHECK-LABEL: define i32 @different_offsets(
; CHECK-SAME: i1 [[COND:%.*]], i32 [[DEPTH:%.*]], ptr [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i32 14, i32 18
; CHECK-NEXT:    [[SRCBITS:%.*]] = select i1 [[COND]], i32 15, i32 20
; CHECK-NEXT:    [[SRCSHIFT:%.*]] = sub nsw i32 [[SRCBITS]], [[DEPTH]]
; CHECK-NEXT:    [[SHIFT:%.*]] = add nsw i32 [[SRCSHIFT]], [[BITS]]
; CHECK-NEXT:    store i32 [[SHIFT]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %bits = select i1 %cond, i32 14, i32 18
  %srcbits = select i1 %cond, i32 15, i32 20
  %srcshift = sub nsw i32 %srcbits, %depth
  %shift = add nsw i32 %srcshift, %bits
  store i32 %shift, ptr %out
  %count = add nsw i32 %bits, -1
  %r = shl nuw nsw i32 1, %count
  ret i32 %r
}

; Directly observable selections are not candidates for sharing.
define i32 @stored_offsets(i1 %cond, i32 %depth, ptr %out, ptr %out2) optsize {
; CHECK-LABEL: define i32 @stored_offsets(
; CHECK-SAME: i1 [[COND:%.*]], i32 [[DEPTH:%.*]], ptr [[OUT:%.*]], ptr [[OUT2:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i32 14, i32 18
; CHECK-NEXT:    [[SRCBITS:%.*]] = select i1 [[COND]], i32 15, i32 19
; CHECK-NEXT:    store i32 [[SRCBITS]], ptr [[OUT2]], align 4
; CHECK-NEXT:    [[SRCSHIFT:%.*]] = sub nsw i32 [[SRCBITS]], [[DEPTH]]
; CHECK-NEXT:    [[SHIFT:%.*]] = add nsw i32 [[SRCSHIFT]], [[BITS]]
; CHECK-NEXT:    store i32 [[SHIFT]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %bits = select i1 %cond, i32 14, i32 18
  %srcbits = select i1 %cond, i32 15, i32 19
  store i32 %srcbits, ptr %out2
  %srcshift = sub nsw i32 %srcbits, %depth
  %shift = add nsw i32 %srcshift, %bits
  store i32 %shift, ptr %out
  %count = add nsw i32 %bits, -1
  %r = shl nuw nsw i32 1, %count
  ret i32 %r
}

; A unit offset is already a cheap extension of the condition. Rebuilding the
; selections would duplicate that calculation and grow 30 bytes to 35 on x86.
define i32 @unit_offsets(i32 noundef %v, i32 %depth, ptr %out) optsize {
; CHECK-LABEL: define i32 @unit_offsets(
; CHECK-SAME: i32 noundef [[V:%.*]], i32 [[DEPTH:%.*]], ptr [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[COND:%.*]] = trunc i32 [[V]] to i1
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i32 2, i32 3
; CHECK-NEXT:    [[SRCBITS:%.*]] = select i1 [[COND]], i32 3, i32 4
; CHECK-NEXT:    [[SRCSHIFT:%.*]] = sub i32 [[SRCBITS]], [[DEPTH]]
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[SRCSHIFT]], [[BITS]]
; CHECK-NEXT:    store i32 [[SUM]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %cond = trunc i32 %v to i1
  %bits = select i1 %cond, i32 2, i32 3
  %srcbits = select i1 %cond, i32 3, i32 4
  %srcshift = sub i32 %srcbits, %depth
  %sum = add i32 %srcshift, %bits
  store i32 %sum, ptr %out
  %count = add nsw i32 %bits, -1
  %r = shl nuw nsw i32 1, %count
  ret i32 %r
}

define internal i32 @polynomial(i32 %x, i32 %y) {
; CHECK-LABEL: define internal i32 @polynomial(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
; CHECK-NEXT:    [[P:%.*]] = mul nsw i32 [[X]], [[Y]]
; CHECK-NEXT:    [[R:%.*]] = add nsw i32 [[P]], 1
; CHECK-NEXT:    ret i32 [[R]]
;
  %p = mul nsw i32 %x, %y
  %r = add nsw i32 %p, 1
  ret i32 %r
}

define internal i32 @nine(i32 %x) {
; CHECK-LABEL: define internal i32 @nine(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:    ret i32 9
;
  ret i32 9
}

; The intermediate source shift can also be used independently, as in swscale.
define i64 @shared_offsets_other_use(i1 %cond, i32 %depth, i64 %value, ptr %out) optsize {
; CHECK-LABEL: define i64 @shared_offsets_other_use(
; CHECK-SAME: i1 [[COND:%.*]], i32 [[DEPTH:%.*]], i64 [[VALUE:%.*]], ptr [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i32 14, i32 18
; CHECK-NEXT:    [[SRCBITS:%.*]] = select i1 [[COND]], i32 15, i32 19
; CHECK-NEXT:    [[SRCSHIFT:%.*]] = sub nsw i32 [[SRCBITS]], [[DEPTH]]
; CHECK-NEXT:    [[SHIFT:%.*]] = add nsw i32 [[SRCSHIFT]], [[BITS]]
; CHECK-NEXT:    store i32 [[SHIFT]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[SRCWIDE:%.*]] = zext nneg i32 [[SRCSHIFT]] to i64
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    [[WIDE:%.*]] = zext nneg i32 [[R]] to i64
; CHECK-NEXT:    [[SUM:%.*]] = add i64 [[VALUE]], [[WIDE]]
; CHECK-NEXT:    [[RESULT:%.*]] = add i64 [[SUM]], [[SRCWIDE]]
; CHECK-NEXT:    ret i64 [[RESULT]]
;
  %bits = select i1 %cond, i32 14, i32 18
  %srcbits = select i1 %cond, i32 15, i32 19
  %srcshift = sub nsw i32 %srcbits, %depth
  %shift = add nsw i32 %srcshift, %bits
  store i32 %shift, ptr %out
  %srcwide = zext nneg i32 %srcshift to i64
  %count = add nsw i32 %bits, -1
  %r = shl nuw nsw i32 1, %count
  %wide = zext nneg i32 %r to i64
  %sum = add i64 %value, %wide
  %result = add i64 %sum, %srcwide
  ret i64 %result
}
