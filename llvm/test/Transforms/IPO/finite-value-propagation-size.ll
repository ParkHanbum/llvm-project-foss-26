; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; REQUIRES: x86-registered-target
; RUN: opt -passes='verify' -S %s | FileCheck %s
; RUN: opt -passes='verify' %s -o %t.bc
; RUN: llc -mtriple=x86_64-unknown-linux-gnu -mcpu=x86-64 -filetype=obj %t.bc -o %t.o
; RUN: llvm-nm --print-size --format=posix %t.o | FileCheck %s --check-prefix=SIZE
;
; SIZE-DAG: size_optimized_rounding T {{[0-9a-f]+}} 1d
; SIZE-DAG: large_constants T {{[0-9a-f]+}} 11
; SIZE-DAG: shared_offsets T {{[0-9a-f]+}} 34{{$}}
; SIZE-DAG: shared_offsets_reversed T {{[0-9a-f]+}} 28{{$}}
; SIZE-DAG: unit_offsets T {{[0-9a-f]+}} 1e

target triple = "x86_64-unknown-linux-gnu"

; Adding a comparison and select ties the size of the existing add and shift.
define i32 @size_optimized(i32 noundef range(i32 5, 7) %bits) optsize {
; CHECK-LABEL: define i32 @size_optimized(
; CHECK-SAME: i32 noundef range(i32 5, 7) [[BITS:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[COUNT:%.*]] = add i32 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl i32 1, [[COUNT]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %count = add i32 %bits, -1
  %r = shl i32 1, %count
  ret i32 %r
}

; A retained input is cheap to reuse; a second select needs two more constants.
define i64 @size_optimized_rounding(i1 %cond, ptr %out) optsize {
; CHECK-LABEL: define i64 @size_optimized_rounding(
; CHECK-SAME: i1 [[COND:%.*]], ptr [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i32 14, i32 18
; CHECK-NEXT:    store i32 [[BITS]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    [[WIDE:%.*]] = zext nneg i32 [[R]] to i64
; CHECK-NEXT:    ret i64 [[WIDE]]
;
  %bits = select i1 %cond, i32 14, i32 18
  store i32 %bits, ptr %out
  %count = add nsw i32 %bits, -1
  %r = shl nuw nsw i32 1, %count
  %wide = zext nneg i32 %r to i64
  ret i64 %wide
}

; Reusing a condition still needs a strict size saving. The input stays live.
define i32 @size_optimized_shared_count(i1 %cond, ptr %out) optsize {
; CHECK-LABEL: define i32 @size_optimized_shared_count(
; CHECK-SAME: i1 [[COND:%.*]], ptr [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[COUNT:%.*]] = select i1 [[COND]], i32 13, i32 17
; CHECK-NEXT:    store i32 [[COUNT]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %count = select i1 %cond, i32 13, i32 17
  store i32 %count, ptr %out
  %r = shl nuw nsw i32 1, %count
  ret i32 %r
}

; Three outcomes would introduce more code than the add and shift remove.
define i32 @size_optimized_three_values(i32 noundef range(i32 5, 8) %bits) optsize {
; CHECK-LABEL: define i32 @size_optimized_three_values(
; CHECK-SAME: i32 noundef range(i32 5, 8) [[BITS:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %count = add nsw i32 %bits, -1
  %r = shl nuw nsw i32 1, %count
  ret i32 %r
}

; A division's throughput benefit does not pay for extra code under optsize.
define i32 @size_optimized_division(i32 noundef range(i32 5, 7) %x) optsize {
; CHECK-LABEL: define i32 @size_optimized_division(
; CHECK-SAME: i32 noundef range(i32 5, 7) [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[R:%.*]] = udiv i32 1000, [[X]]
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = udiv i32 1000, %x
  ret i32 %r
}

; Calls do not bypass the code-size gate: the callee may have other callers.
define i32 @size_optimized_call(i32 noundef range(i32 1, 4) %x) optsize {
; CHECK-LABEL: define i32 @size_optimized_call(
; CHECK-SAME: i32 noundef range(i32 1, 4) [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[R:%.*]] = call i32 @polynomial(i32 [[X]], i32 [[X]])
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = call i32 @polynomial(i32 %x, i32 %x)
  ret i32 %r
}

define i32 @size_optimized_uniform(i32 noundef range(i32 2, 4) %x) optsize {
; CHECK-LABEL: define i32 @size_optimized_uniform(
; CHECK-SAME: i32 noundef range(i32 2, 4) [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[R:%.*]] = call i32 @nine(i32 [[X]])
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = call i32 @nine(i32 %x)
  ret i32 %r
}

; Minsize uses the same code-size policy.
define i16 @minimum_size_select(i1 %cond) minsize {
; CHECK-LABEL: define i16 @minimum_size_select(
; CHECK-SAME: i1 [[COND:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i16 2, i16 3
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i16 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i16 1, [[COUNT]]
; CHECK-NEXT:    ret i16 [[R]]
;
  %bits = select i1 %cond, i16 2, i16 3
  %count = add nsw i16 %bits, -1
  %r = shl nuw nsw i16 1, %count
  ret i16 %r
}

; Large i64 immediates lose even when the input selection dies.
define i64 @large_constants(i1 noundef %cond) optsize {
; CHECK-LABEL: define i64 @large_constants(
; CHECK-SAME: i1 noundef [[COND:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i64 33, i64 34
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i64 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i64 1, [[COUNT]]
; CHECK-NEXT:    ret i64 [[R]]
;
  %bits = select i1 %cond, i64 33, i64 34
  %count = add nsw i64 %bits, -1
  %r = shl nuw nsw i64 1, %count
  ret i64 %r
}

; Arithmetic offsets can share one small discriminator instead of materializing
; the two large one-hot constants. This is the swscale rounding calculation.
define i64 @shared_offsets(i1 %cond, i32 %depth, i64 %value, ptr %out) optsize {
; CHECK-LABEL: define i64 @shared_offsets(
; CHECK-SAME: i1 [[COND:%.*]], i32 [[DEPTH:%.*]], i64 [[VALUE:%.*]], ptr [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i32 14, i32 18
; CHECK-NEXT:    [[SRCBITS:%.*]] = select i1 [[COND]], i32 15, i32 19
; CHECK-NEXT:    [[SRCSHIFT:%.*]] = sub nsw i32 [[SRCBITS]], [[DEPTH]]
; CHECK-NEXT:    [[SHIFT:%.*]] = add nsw i32 [[SRCSHIFT]], [[BITS]]
; CHECK-NEXT:    store i32 [[SHIFT]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    [[WIDE:%.*]] = zext nneg i32 [[R]] to i64
; CHECK-NEXT:    [[SUM:%.*]] = add i64 [[VALUE]], [[WIDE]]
; CHECK-NEXT:    ret i64 [[SUM]]
;
  %bits = select i1 %cond, i32 14, i32 18
  %srcbits = select i1 %cond, i32 15, i32 19
  %srcshift = sub nsw i32 %srcbits, %depth
  %shift = add nsw i32 %srcshift, %bits
  store i32 %shift, ptr %out
  %count = add nsw i32 %bits, -1
  %r = shl nuw nsw i32 1, %count
  %wide = zext nneg i32 %r to i64
  %sum = add i64 %value, %wide
  ret i64 %sum
}

; Reverse arm order and an earlier sibling must preserve dominance and polarity.
define i64 @shared_offsets_reversed(i1 %cond, i32 %depth, i64 %value, ptr %out) optsize {
; CHECK-LABEL: define i64 @shared_offsets_reversed(
; CHECK-SAME: i1 [[COND:%.*]], i32 [[DEPTH:%.*]], i64 [[VALUE:%.*]], ptr [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[SRCBITS:%.*]] = select i1 [[COND]], i32 19, i32 15
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i32 18, i32 14
; CHECK-NEXT:    [[SRCSHIFT:%.*]] = sub nsw i32 [[SRCBITS]], [[DEPTH]]
; CHECK-NEXT:    [[SHIFT:%.*]] = add nsw i32 [[SRCSHIFT]], [[BITS]]
; CHECK-NEXT:    store i32 [[SHIFT]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    [[WIDE:%.*]] = zext nneg i32 [[R]] to i64
; CHECK-NEXT:    [[SUM:%.*]] = add i64 [[VALUE]], [[WIDE]]
; CHECK-NEXT:    ret i64 [[SUM]]
;
  %srcbits = select i1 %cond, i32 19, i32 15
  %bits = select i1 %cond, i32 18, i32 14
  %srcshift = sub nsw i32 %srcbits, %depth
  %shift = add nsw i32 %srcshift, %bits
  store i32 %shift, ptr %out
  %count = add nsw i32 %bits, -1
  %r = shl nuw nsw i32 1, %count
  %wide = zext nneg i32 %r to i64
  %sum = add i64 %value, %wide
  ret i64 %sum
}

