; CHECK-SAME: i1 noundef [[COND:%.*]]) {
; CHECK-NEXT:    [[X:%.*]] = select i1 [[COND]], i32 2, i32 4
; CHECK-NEXT:    [[R:%.*]] = call i32 @wrapper(i32 [[X]])
; CHECK-NEXT:    ret i32 [[R]]
;
; O3-LABEL: define i32 @nested(
; O3-SAME: i1 noundef [[COND:%.*]]) local_unnamed_addr #[[ATTR1]] {
; O3-NEXT:    [[X:%.*]] = select i1 [[COND]], i32 2, i32 4
; O3-NEXT:    [[R:%.*]] = tail call fastcc i32 @wrapper(i32 [[X]])
; O3-NEXT:    ret i32 [[R]]
;
  %x = select i1 %cond, i32 2, i32 4
  %r = call i32 @wrapper(i32 %x)
  ret i32 %r
}

define i32 @ordinary(i32 %x) noinline {
; CHECK-LABEL: define i32 @ordinary(
; CHECK-SAME: i32 [[X:%.*]]) #[[ATTR1]] {
; CHECK-NEXT:    [[R:%.*]] = add i32 [[X]], 1
; CHECK-NEXT:    ret i32 [[R]]
;
