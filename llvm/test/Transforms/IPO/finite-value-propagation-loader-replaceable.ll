define i32 @call_site(i1 noundef %cond) {
; CHECK-LABEL: define i32 @call_site(
; CHECK-SAME: i1 noundef [[COND:%.*]]) {
; CHECK-NEXT:    [[X:%.*]] = select i1 [[COND]], i32 2, i32 4
; CHECK-NEXT:    [[R:%.*]] = call i32 @ordinary(i32 [[X]]) #[[ATTR0]]
; CHECK-NEXT:    ret i32 [[R]]
;
; O3-LABEL: define i32 @call_site(
; O3-SAME: i1 noundef [[COND:%.*]]) local_unnamed_addr #[[ATTR1]] {
; O3-NEXT:    [[X:%.*]] = select i1 [[COND]], i32 2, i32 4
; O3-NEXT:    [[R:%.*]] = tail call i32 @ordinary(i32 [[X]]) #[[ATTR3:[0-9]+]]
; O3-NEXT:    ret i32 [[R]]
;
