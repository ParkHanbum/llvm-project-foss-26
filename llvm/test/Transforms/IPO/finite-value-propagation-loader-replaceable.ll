; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -passes='verify' -S %s | FileCheck %s
; RUN: opt -passes='default<O3>,verify' -S %s | FileCheck %s --check-prefix=O3

target datalayout = "e-p:64:64-i64:64-n8:16:32:64"
target triple = "unknown-unknown-unknown"

; Exact definitions can still be replaced by the Windows loader. The same guard
; is necessary when evaluating a nested call, and on call-site attributes.
define i32 @loader_replaced(i32 %x) "loader-replaceable" {
; CHECK-LABEL: define i32 @loader_replaced(
; CHECK-SAME: i32 [[X:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[R:%.*]] = add i32 [[X]], 1
; CHECK-NEXT:    ret i32 [[R]]
;
; O3-LABEL: define i32 @loader_replaced(
; O3-SAME: i32 [[X:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; O3-NEXT:    [[R:%.*]] = add i32 [[X]], 1
; O3-NEXT:    ret i32 [[R]]
;
  %r = add i32 %x, 1
  ret i32 %r
}

define i32 @direct(i1 noundef %cond) {
; CHECK-LABEL: define i32 @direct(
; CHECK-SAME: i1 noundef [[COND:%.*]]) {
; CHECK-NEXT:    [[X:%.*]] = select i1 [[COND]], i32 2, i32 4
; CHECK-NEXT:    [[R:%.*]] = call i32 @loader_replaced(i32 [[X]])
; CHECK-NEXT:    ret i32 [[R]]
;
; O3-LABEL: define i32 @direct(
; O3-SAME: i1 noundef [[COND:%.*]]) local_unnamed_addr #[[ATTR1:[0-9]+]] {
; O3-NEXT:    [[X:%.*]] = select i1 [[COND]], i32 2, i32 4
; O3-NEXT:    [[R:%.*]] = tail call i32 @loader_replaced(i32 [[X]])
; O3-NEXT:    ret i32 [[R]]
;
  %x = select i1 %cond, i32 2, i32 4
  %r = call i32 @loader_replaced(i32 %x)
  ret i32 %r
}

define internal i32 @wrapper(i32 %x) noinline {
; CHECK-LABEL: define internal i32 @wrapper(
; CHECK-SAME: i32 [[X:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    [[R:%.*]] = call i32 @loader_replaced(i32 [[X]])
; CHECK-NEXT:    ret i32 [[R]]
;
; O3-LABEL: define internal fastcc i32 @wrapper(
; O3-SAME: i32 range(i32 2, 5) [[X:%.*]]) unnamed_addr #[[ATTR2:[0-9]+]] {
; O3-NEXT:    [[R:%.*]] = tail call i32 @loader_replaced(i32 [[X]])
; O3-NEXT:    ret i32 [[R]]
;
  %r = call i32 @loader_replaced(i32 %x)
  ret i32 %r
}

