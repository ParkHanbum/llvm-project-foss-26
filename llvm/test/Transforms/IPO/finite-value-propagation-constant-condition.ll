  %srcbits = select i1 true, i32 15, i32 19
  %part = sub i32 %srcbits, %depth
  %sum = add i32 %part, %bits
  store i32 %sum, ptr %out
  %count = add nsw i32 %bits, -1
  %r = shl nuw nsw i32 1, %count
  %wide = zext nneg i32 %r to i64
  %result = add i64 %value, %wide
  ret i64 %result
}

