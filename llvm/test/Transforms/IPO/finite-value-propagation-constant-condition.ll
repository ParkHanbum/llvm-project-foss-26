; CHECK-NEXT:    [[BITS:%.*]] = select i1 true, i32 14, i32 18
; CHECK-NEXT:    [[SRCBITS:%.*]] = select i1 true, i32 15, i32 19
; CHECK-NEXT:    [[PART:%.*]] = sub i32 [[SRCBITS]], [[DEPTH]]
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[PART]], [[BITS]]
; CHECK-NEXT:    store i32 [[SUM]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[R:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    [[WIDE:%.*]] = zext nneg i32 [[R]] to i64
; CHECK-NEXT:    [[RESULT:%.*]] = add i64 [[VALUE]], [[WIDE]]
; CHECK-NEXT:    ret i64 [[RESULT]]
;
