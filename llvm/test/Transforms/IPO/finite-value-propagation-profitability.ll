; Even a dead add and shift do not pay for a selection when the shift folds
; into its consumer. Keep the bit-index representation available to lowering.
define i1 @bit_test(i1 %c, i64 %x, ptr %out) {
; CHECK-LABEL: define i1 @bit_test(
; CHECK-SAME: i1 [[C:%.*]], i64 [[X:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[C]], i64 3, i64 5
; CHECK-NEXT:    store i64 [[BITS]], ptr [[OUT]], align 8
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i64 [[BITS]], -1
; CHECK-NEXT:    [[MASK:%.*]] = shl nuw nsw i64 1, [[COUNT]]
; CHECK-NEXT:    [[TEST:%.*]] = and i64 [[X]], [[MASK]]
; CHECK-NEXT:    [[RESULT:%.*]] = icmp ne i64 [[TEST]], 0
; CHECK-NEXT:    ret i1 [[RESULT]]
;
; ASM-LABEL: bit_test:
; ASM: bt{{[lq]}}
  %bits = select i1 %c, i64 3, i64 5
  store i64 %bits, ptr %out
  %count = add nsw i64 %bits, -1
  %mask = shl nuw nsw i64 1, %count
  %test = and i64 %x, %mask
  %result = icmp ne i64 %test, 0
  ret i1 %result
}

