; Costs from a less frequently executed block cannot pay for new work in a
; different block. Nor should a retained input get a second typed selection.
define i32 @nonlocal_input(i1 %c, i1 %enter, ptr %out) {
; CHECK-LABEL: define i32 @nonlocal_input(
; CHECK-SAME: i1 [[C:%.*]], i1 [[ENTER:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[C]], i32 3, i32 5
; CHECK-NEXT:    store i32 [[BITS]], ptr [[OUT]], align 4
; CHECK-NEXT:    br i1 [[ENTER]], label %[[COMPUTE:.*]], label %[[EXIT:.*]]
; CHECK:       [[COMPUTE]]:
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[MASK:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    ret i32 [[MASK]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i32 0
;
entry:
  %bits = select i1 %c, i32 3, i32 5
  store i32 %bits, ptr %out
  br i1 %enter, label %compute, label %exit
compute:
  %count = add nsw i32 %bits, -1
  %mask = shl nuw nsw i32 1, %count
  ret i32 %mask
exit:
  ret i32 0
}

