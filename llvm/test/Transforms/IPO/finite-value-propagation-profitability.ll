; The retained count can be live through a different conditional selection.
; A second selection of the mask can change spills in its successor loops.
define i32 @retained_conditional_input(i1 %c, i1 %other, i32 %x, ptr %out) {
; CHECK-LABEL: define i32 @retained_conditional_input(
; CHECK-SAME: i1 [[C:%.*]], i1 [[OTHER:%.*]], i32 [[X:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[C]], i32 4, i32 7
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[MASK:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    [[FORWARD:%.*]] = select i1 [[OTHER]], i32 [[X]], i32 [[BITS]]
; CHECK-NEXT:    store i32 [[FORWARD]], ptr [[OUT]], align 4
; CHECK-NEXT:    ret i32 [[MASK]]
;
  %bits = select i1 %c, i32 4, i32 7
  %count = add nsw i32 %bits, -1
  %mask = shl nuw nsw i32 1, %count
  %forward = select i1 %other, i32 %x, i32 %bits
  store i32 %forward, ptr %out
  ret i32 %mask
}

