; Do not break a shared shift count into several independently tied selections.
define void @multiple_masks_shared_count(i1 %c, ptr %out, ptr %out2) {
; CHECK-LABEL: define void @multiple_masks_shared_count(
; CHECK-SAME: i1 [[C:%.*]], ptr [[OUT:%.*]], ptr [[OUT2:%.*]]) {
; CHECK-NEXT:    [[COUNT:%.*]] = select i1 [[C]], i32 2, i32 4
; CHECK-NEXT:    [[FIRST:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    [[SECOND:%.*]] = shl nuw nsw i32 2, [[COUNT]]
; CHECK-NEXT:    store i32 [[FIRST]], ptr [[OUT]], align 4
; CHECK-NEXT:    store i32 [[SECOND]], ptr [[OUT2]], align 4
; CHECK-NEXT:    ret void
;
  %count = select i1 %c, i32 2, i32 4
  %first = shl nuw nsw i32 1, %count
  %second = shl nuw nsw i32 2, %count
  store i32 %first, ptr %out
  store i32 %second, ptr %out2
  ret void
}
