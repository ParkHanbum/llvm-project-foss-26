; An arithmetic use already requires materializing the mask. Do not charge
; the shift as free just because another use can test the selected bit.
define i1 @mask_used_as_value(i1 %c, i32 %x, ptr %out, ptr %sum_out) {
; CHECK-LABEL: define i1 @mask_used_as_value(
; CHECK-SAME: i1 [[C:%.*]], i32 [[X:%.*]], ptr [[OUT:%.*]], ptr [[SUM_OUT:%.*]]) {
; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[C]], i32 3, i32 5
; CHECK-NEXT:    store i32 [[BITS]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[COUNT:%.*]] = add nsw i32 [[BITS]], -1
; CHECK-NEXT:    [[MASK:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    [[TEST:%.*]] = and i32 [[X]], [[MASK]]
; CHECK-NEXT:    [[SUM:%.*]] = add i32 [[MASK]], 1
; CHECK-NEXT:    store i32 [[SUM]], ptr [[SUM_OUT]], align 4
; CHECK-NEXT:    [[RESULT:%.*]] = icmp ne i32 [[TEST]], 0
; CHECK-NEXT:    ret i1 [[RESULT]]
;
  %bits = select i1 %c, i32 3, i32 5
  store i32 %bits, ptr %out
  %count = add nsw i32 %bits, -1
  %mask = shl nuw nsw i32 1, %count
  %test = and i32 %x, %mask
  %sum = add i32 %mask, 1
  store i32 %sum, ptr %sum_out
  %result = icmp ne i32 %test, 0
  ret i1 %result
}

; Replacing a shift of a retained count with a second, equally costly select
; can repeat tests or increase register pressure. Tied throughput is not enough.
define i32 @retained_count(i1 %c, ptr %out) {
; CHECK-LABEL: define i32 @retained_count(
; CHECK-SAME: i1 [[C:%.*]], ptr [[OUT:%.*]]) {
; CHECK-NEXT:    [[COUNT:%.*]] = select i1 [[C]], i32 13, i32 17
; CHECK-NEXT:    store i32 [[COUNT]], ptr [[OUT]], align 4
; CHECK-NEXT:    [[MASK:%.*]] = shl nuw nsw i32 1, [[COUNT]]
; CHECK-NEXT:    ret i32 [[MASK]]
;
  %count = select i1 %c, i32 13, i32 17
  store i32 %count, ptr %out
  %mask = shl nuw nsw i32 1, %count
  ret i32 %mask
}

