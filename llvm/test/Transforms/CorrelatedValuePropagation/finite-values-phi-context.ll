; RUN: opt -passes='correlated-propagation<finite-values>,verify' -S %s | FileCheck %s

; An unbound PHI is not an ordinary expression node. Its incoming definitions
; need not dominate the multiplication, and cannot be queried there in LVI.
define i32 @phi_context(i1 noundef %c, i1 noundef %d, i32 noundef %x) {
; CHECK-LABEL: define i32 @phi_context(
; CHECK-SAME: i1 noundef [[C:%.*]], i1 noundef [[D:%.*]], i32 noundef [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[LEFT:.*]], label %[[RIGHT:.*]]
; CHECK:       [[LEFT]]:
; CHECK-NEXT:    [[A:%.*]] = add i32 [[X]], 1
; CHECK-NEXT:    br label %[[MERGE:.*]]
; CHECK:       [[RIGHT]]:
; CHECK-NEXT:    [[B:%.*]] = sub i32 [[X]], 1
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[P:%.*]] = phi i32 [ [[A]], %[[LEFT]] ], [ [[B]], %[[RIGHT]] ]
; CHECK-NEXT:    [[N:%.*]] = select i1 [[D]], i32 2, i32 3
; CHECK-NEXT:    [[R:%.*]] = mul i32 [[P]], [[N]]
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
  br i1 %c, label %left, label %right
left:
  %a = add i32 %x, 1
  br label %merge
right:
  %b = sub i32 %x, 1
  br label %merge
merge:
  %p = phi i32 [ %a, %left ], [ %b, %right ]
  %n = select i1 %d, i32 2, i32 3
  %r = mul i32 %p, %n
  ret i32 %r
}
