; CHECK-NEXT:    [[TMP1:%.*]] = load <1 x double>, ptr [[PYHI]], align 16
; CHECK-NEXT:    [[SHUF0:%.*]] = shufflevector <2 x double> [[X0]], <2 x double> [[Y0]], <4 x i32> <i32 1, i32 2, i32 poison, i32 poison>
; CHECK-NEXT:    [[SHUF1:%.*]] = shufflevector <2 x double> [[X1]], <2 x double> poison, <4 x i32> <i32 poison, i32 1, i32 poison, i32 poison>
; CHECK-NEXT:    [[SHUF2:%.*]] = shufflevector <4 x double> [[SHUF0]], <4 x double> [[SHUF1]], <4 x i32> <i32 0, i32 1, i32 5, i32 poison>
; CHECK-NEXT:    [[SHUF3:%.*]] = shufflevector <1 x double> [[TMP1]], <1 x double> poison, <4 x i32> <i32 0, i32 poison, i32 poison, i32 poison>
; CHECK-NEXT:    [[SHUF4:%.*]] = shufflevector <4 x double> [[SHUF2]], <4 x double> [[SHUF3]], <4 x i32> <i32 0, i32 1, i32 2, i32 4>
; CHECK-NEXT:    store <2 x double> [[X1]], ptr [[OUT]], align 1
; CHECK-NEXT:    ret <4 x double> [[SHUF4]]
;
  %pxhi = getelementptr inbounds nuw i8, ptr %px, i64 16
  %pyhi = getelementptr inbounds nuw i8, ptr %py, i64 16
  %x0 = load <2 x double>, ptr %px, align 16
  %y0 = load <2 x double>, ptr %py, align 16
  %x1 = load <2 x double>, ptr %pxhi, align 16
  %y1 = load <2 x double>, ptr %pyhi, align 16
  %shuf0 = shufflevector <2 x double> %x0, <2 x double> %y0, <4 x i32> <i32 1, i32 2, i32 poison, i32 poison>
  %shuf1 = shufflevector <2 x double> %x1, <2 x double> poison, <4 x i32> <i32 poison, i32 1, i32 poison, i32 poison>
  %shuf2 = shufflevector <4 x double> %shuf0, <4 x double> %shuf1, <4 x i32> <i32 0, i32 1, i32 5, i32 poison>
  %shuf3 = shufflevector <2 x double> %y1, <2 x double> poison, <4 x i32> <i32 0, i32 poison, i32 poison, i32 poison>
  %shuf4 = shufflevector <4 x double> %shuf2, <4 x double> %shuf3, <4 x i32> <i32 0, i32 1, i32 2, i32 4>
  store <2 x double> %x1, ptr %out, align 1
  ret <4 x double> %shuf4
}

; Keep loads and their shuffle tree in the same basic block.
define <4 x double> @cross_block(ptr %px, ptr %py) {
; CHECK-LABEL: define <4 x double> @cross_block(
; CHECK-SAME: ptr [[PX:%.*]], ptr [[PY:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[PXHI:%.*]] = getelementptr inbounds nuw i8, ptr [[PX]], i64 16
; CHECK-NEXT:    [[PYHI:%.*]] = getelementptr inbounds nuw i8, ptr [[PY]], i64 16
; CHECK-NEXT:    [[X0:%.*]] = load <2 x double>, ptr [[PX]], align 16
; CHECK-NEXT:    [[Y0:%.*]] = load <2 x double>, ptr [[PY]], align 16
; CHECK-NEXT:    [[X1:%.*]] = load <2 x double>, ptr [[PXHI]], align 16
; CHECK-NEXT:    [[TMP1:%.*]] = load <1 x double>, ptr [[PYHI]], align 16
; CHECK-NEXT:    br label %[[SHUFFLE:.*]]
; CHECK:       [[SHUFFLE]]:
; CHECK-NEXT:    [[SHUF0:%.*]] = shufflevector <2 x double> [[X0]], <2 x double> [[Y0]], <4 x i32> <i32 1, i32 2, i32 poison, i32 poison>
; CHECK-NEXT:    [[SHUF1:%.*]] = shufflevector <2 x double> [[X1]], <2 x double> poison, <4 x i32> <i32 poison, i32 1, i32 poison, i32 poison>
; CHECK-NEXT:    [[SHUF2:%.*]] = shufflevector <4 x double> [[SHUF0]], <4 x double> [[SHUF1]], <4 x i32> <i32 0, i32 1, i32 5, i32 poison>
; CHECK-NEXT:    [[SHUF3:%.*]] = shufflevector <1 x double> [[TMP1]], <1 x double> poison, <4 x i32> <i32 0, i32 poison, i32 poison, i32 poison>
; CHECK-NEXT:    [[SHUF4:%.*]] = shufflevector <4 x double> [[SHUF2]], <4 x double> [[SHUF3]], <4 x i32> <i32 0, i32 1, i32 2, i32 4>
; CHECK-NEXT:    ret <4 x double> [[SHUF4]]
;
  %pxhi = getelementptr inbounds nuw i8, ptr %px, i64 16
  %pyhi = getelementptr inbounds nuw i8, ptr %py, i64 16
  %x0 = load <2 x double>, ptr %px, align 16
  %y0 = load <2 x double>, ptr %py, align 16
  %x1 = load <2 x double>, ptr %pxhi, align 16
  %y1 = load <2 x double>, ptr %pyhi, align 16
  br label %shuffle

shuffle:
  %shuf0 = shufflevector <2 x double> %x0, <2 x double> %y0, <4 x i32> <i32 1, i32 2, i32 poison, i32 poison>
  %shuf1 = shufflevector <2 x double> %x1, <2 x double> poison, <4 x i32> <i32 poison, i32 1, i32 poison, i32 poison>
  %shuf2 = shufflevector <4 x double> %shuf0, <4 x double> %shuf1, <4 x i32> <i32 0, i32 1, i32 5, i32 poison>
  %shuf3 = shufflevector <2 x double> %y1, <2 x double> poison, <4 x i32> <i32 0, i32 poison, i32 poison, i32 poison>
  %shuf4 = shufflevector <4 x double> %shuf2, <4 x double> %shuf3, <4 x i32> <i32 0, i32 1, i32 2, i32 4>
  ret <4 x double> %shuf4
}

; Keep the original tree when reassociation does not reduce the shuffle cost.
define <4 x double> @balanced_narrow(ptr %px, ptr %py) {
; CHECK-LABEL: define <4 x double> @balanced_narrow(
; CHECK-SAME: ptr [[PX:%.*]], ptr [[PY:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[PXHI:%.*]] = getelementptr inbounds nuw i8, ptr [[PX]], i64 16
; CHECK-NEXT:    [[PYHI:%.*]] = getelementptr inbounds nuw i8, ptr [[PY]], i64 16
; CHECK-NEXT:    [[X0:%.*]] = load <2 x double>, ptr [[PX]], align 16
; CHECK-NEXT:    [[Y0:%.*]] = load <2 x double>, ptr [[PY]], align 16
; CHECK-NEXT:    [[X1:%.*]] = load <2 x double>, ptr [[PXHI]], align 16
; CHECK-NEXT:    [[Y1:%.*]] = load <2 x double>, ptr [[PYHI]], align 16
; CHECK-NEXT:    [[LO:%.*]] = shufflevector <2 x double> [[X0]], <2 x double> [[Y0]], <2 x i32> <i32 1, i32 2>
; CHECK-NEXT:    [[HI:%.*]] = shufflevector <2 x double> [[X1]], <2 x double> [[Y1]], <2 x i32> <i32 1, i32 2>
; CHECK-NEXT:    [[R:%.*]] = shufflevector <2 x double> [[LO]], <2 x double> [[HI]], <4 x i32> <i32 0, i32 1, i32 2, i32 3>
; CHECK-NEXT:    ret <4 x double> [[R]]
;
  %pxhi = getelementptr inbounds nuw i8, ptr %px, i64 16
  %pyhi = getelementptr inbounds nuw i8, ptr %py, i64 16
  %x0 = load <2 x double>, ptr %px, align 16
  %y0 = load <2 x double>, ptr %py, align 16
  %x1 = load <2 x double>, ptr %pxhi, align 16
  %y1 = load <2 x double>, ptr %pyhi, align 16
  %lo = shufflevector <2 x double> %x0, <2 x double> %y0, <2 x i32> <i32 1, i32 2>
  %hi = shufflevector <2 x double> %x1, <2 x double> %y1, <2 x i32> <i32 1, i32 2>
  %r = shufflevector <2 x double> %lo, <2 x double> %hi, <4 x i32> <i32 0, i32 1, i32 2, i32 3>
  ret <4 x double> %r
}
